      "position": [
        0,
        200
      ],
      "webhookId": "f0bc301c-e277-59e5-95e4-902ceec54619"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT jsonb_build_object(\n  'generated_at', now(),\n  'leads', COALESCE((SELECT jsonb_agg(jsonb_build_array(\n             source, opted_in_at, first_reply_at, qualification, score, booked_at, showed_at, no_show_at)\n             ORDER BY opted_in_at)\n           FROM leads WHERE opted_in_at > now() - interval '180 days'), '[]'::jsonb),\n  'spend', COALESCE((SELECT jsonb_agg(jsonb_build_array(date, source, line_item, amount_usd) ORDER BY date)\n           FROM ad_spend WHERE date > current_date - 180), '[]'::jsonb)\n) AS data;",
        "options": {}
      },
      "id": "5a169c30-454f-50e7-845c-012e17e66e95",
      "name": "Leads + spend (no PII)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "stl-postgres",
          "name": "STL Postgres"
        }
      }
    },
    {
