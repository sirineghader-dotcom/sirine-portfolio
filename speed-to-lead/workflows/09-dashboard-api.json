{
  "name": "STL 09 \u00b7 Dashboard API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "stl/dashboard",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ef5577a6-7aa8-5643-9e8a-b472c078bfeb",
      "name": "GET /stl/dashboard",
