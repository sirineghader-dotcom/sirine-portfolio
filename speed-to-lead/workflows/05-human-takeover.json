          },
          "conditions": [
            {
              "id": "2f33dc47-1bca-528e-a902-67c2a10a112b",
              "leftValue": "={{ $('Normalize message').item.json.kind === 'human_reply' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0ed155b3-0b60-5ef0-8a8b-7dae299d93a1",
      "name": "Team member replied?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH paused AS (\n  UPDATE leads SET automation_paused = true, paused_reason = $2, paused_at = now(), updated_at = now()\n  WHERE contact_id = $1 AND NOT automation_paused\n  RETURNING id, email, first_name, last_name, phone, company, source\n),\nkilled AS (\n  UPDATE scheduled_messages SET status = 'cancelled', cancel_reason = $2, done_at = now()\n  WHERE contact_id = $1 AND status = 'pending'\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM paused) AS leads_paused, (SELECT count(*) FROM killed) AS messages_cancelled,\n       (SELECT to_jsonb(p) FROM paused p LIMIT 1) AS lead;",
        "options": {
          "queryReplacement": "={{ [ $('Normalize message').item.json.contact_id, 'human_reply' ] }}"
        }
      },
      "id": "c9bbb1d3-ea01-5770-ac26-4a56a3e85982",
      "name": "Pause lead + cancel queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "stl-postgres",
          "name": "STL Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "56d13078-98c5-5180-8a7c-e48e2947255c",
              "leftValue": "={{ Number($json.leads_paused) > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b6ad4c9-2052-5bac-8257-ae9d42c5c1bc",
      "name": "One of our leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Load settings').first().json.cfg.GHL_HOOK_CONTACT }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  email: $('Pause lead + cancel queue').item.json.lead.email, first_name: $('Pause lead + cancel queue').item.json.lead.first_name || '', last_name: $('Pause lead + cancel queue').item.json.lead.last_name || '', phone: $('Pause lead + cancel queue').item.json.lead.phone || '',\n  company: $('Pause lead + cancel queue').item.json.lead.company || '', source: $('Pause lead + cancel queue').item.json.lead.source,\n  source_label: ({meta: 'Meta Lead Ad', website: 'Website form', referral: 'Referral'})[$('Pause lead + cancel queue').item.json.lead.source] || $('Pause lead + cancel queue').item.json.lead.source,\n  source_tag: 'source-' + $('Pause lead + cancel queue').item.json.lead.source,\n  stage: '', status: 'open',\n  qualification: '', score: '', reason: '',\n  extra_tag: 'human-takeover'\n}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "9227c67f-9a66-5263-8355-fc8c45589b84",
      "name": "GHL: tag human-takeover",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const m = $('Normalize message').first().json, r = $('Pause lead + cancel queue').first().json;\nreturn { json: {\n  severity: 'info', workflow: $workflow.name, node: 'Notice: automation paused',\n  message: `A team member replied to ${m.contact_id}. Automation is now OFF for this lead and ${r.messages_cancelled} queued message(s) were cancelled.`,\n  alert_key: 'takeover:' + m.contact_id, execution_id: $execution.id, context: { contact_id: m.contact_id },\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "78d02442-7572-5f1e-b072-3b5e2f95b95d",
      "name": "Notice: automation paused",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
