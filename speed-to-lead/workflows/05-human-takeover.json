        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5280aedf-46ab-57d1-a5e4-959987b82215",
              "leftValue": "={{ /^\\s*(stop|unsubscribe|cancel|end|quit|stopall)\\s*$/i.test($('Normalize message').item.json.body) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c7787ec5-b806-5a4e-9c6b-54e4f41e1918",
      "name": "Opt-out word?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        320
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH paused AS (\n  UPDATE leads SET automation_paused = true, paused_reason = 'opted_out', paused_at = now()\n  WHERE contact_id = $1 AND NOT automation_paused RETURNING id\n)\nUPDATE scheduled_messages SET status = 'cancelled', cancel_reason = 'opted_out', done_at = now()\nWHERE contact_id = $1 AND status = 'pending' RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Normalize message').item.json.contact_id ] }}"
        }
      },
      "id": "b6d650dc-f4df-584a-8643-dc234c492364",
      "name": "Pause lead (opted out)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        260
      ],
      "credentials": {
        "postgres": {
          "id": "stl-postgres",
          "name": "STL Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const m = $('Normalize message').first().json;\nreturn { json: {\n  severity: 'info', workflow: $workflow.name, node: 'Notice: lead replied',\n  message: `Lead ${m.contact_id} replied by ${m.channel || 'message'}: \"${m.body}\". Reply in GHL; your reply pauses the automation for them.`,\n  alert_key: 'reply:' + m.message_id, execution_id: $execution.id, context: { contact_id: m.contact_id },\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "97e93b05-eb4d-51a7-8e41-f6aff71cf912",
      "name": "Notice: lead replied",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
