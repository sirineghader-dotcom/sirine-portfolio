{
  "name": "STL 05 \u00b7 Human takeover + replies",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stl/message",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "8a90d94c-c0d3-5d27-a0e3-0e611f397328",
      "name": "GHL message webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "11448ab8-e7fc-5c8f-8529-e8264419ef46"
    },
    {
      "parameters": {
        "jsCode": "// Sent by the GHL workflows \"SG STL \u00b7 Team replied\" (trigger: User replied) and\n// \"SG STL \u00b7 Lead replied\" (trigger: Customer replied), each with custom data kind.\n// \"User replied\" fires only for a person on the team, never for workflow emails.\nconst b = $json.body || {};\nconst cd = b.customData || b.custom_data || {};\nlet kind = cd.kind || b.kind;\nif (!kind && b.direction) kind = String(b.direction).toLowerCase() === 'inbound' ? 'lead_reply' : 'human_reply';\nconst msg = b.message || {};\nconst contact = String(b.email || b.contact?.email || b.phone || b.contact_id || b.contactId || '').toLowerCase();\nif (!['human_reply', 'lead_reply'].includes(kind) || !contact)\n  throw new Error(`Unrecognised reply payload: ${JSON.stringify(b).slice(0, 500)}`);\nconst id = msg.id || b.messageId || b.message_id || new Date().toISOString().slice(0, 16); // else: same minute = same event\nreturn { json: {\n  kind, contact_id: contact, channel: msg.type || b.messageType || null,\n  body: String(msg.body || b.body || cd.message || '').slice(0, 500),\n  event_key: `msg:${kind}:${contact}:${id}`,\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "7186a866-1d72-5ac6-bcaa-087de2e8ed8b",
      "name": "Normalize message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_events (event_key, kind, payload)\nVALUES ($1, 'message', $2::jsonb)\nON CONFLICT (event_key) DO UPDATE SET hits = processed_events.hits + 1\nRETURNING event_key, (xmax = 0) AS is_new, hits;",
        "options": {
          "queryReplacement": "={{ [ $json.event_key, JSON.stringify($json) ] }}"
        }
      },
      "id": "d02bc33f-8530-55eb-95ef-5e6d09a7ac33",
      "name": "Claim event (dedupe)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "stl-postgres",
          "name": "STL Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "dd4e5718-8c6e-50b7-9ec8-a9e2e5bbba08",
              "leftValue": "={{ $json.is_new }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
