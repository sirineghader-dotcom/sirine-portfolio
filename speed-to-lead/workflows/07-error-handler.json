      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": "__WF_ALERT__",
        "options": {}
      },
      "id": "c9cb1407-cc71-5acd-8b6b-375ca6700493",
      "name": "Send alert",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        440,
        200
      ]
    }
  ],
  "connections": {
