{
  "name": "STL 07 \u00b7 Error handler",
  "nodes": [
    {
      "parameters": {},
      "id": "483c0e7d-8c87-5663-9240-34c20b28c2a2",
      "name": "On any workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json;\nreturn { json: {\n  severity: 'critical',\n  workflow: e.workflow?.name, node: e.execution?.lastNodeExecuted,\n  message: `Execution crashed: ${e.execution?.error?.message || 'unknown error'}`,\n  execution_url: e.execution?.url || '',\n  alert_key: 'exec:' + (e.execution?.id || Date.now()),\n  context: { workflow_id: e.workflow?.id, execution_id: e.execution?.id, mode: e.execution?.mode },\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "1eabb2c6-b47c-55f3-bd37-afa76639f34c",
      "name": "Shape alert",
      "type": "n8n-nodes-base.code",
